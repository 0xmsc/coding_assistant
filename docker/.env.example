# Copy to docker/.env and fill in local values:
# cp docker/.env.example docker/.env

# Must be an absolute host path. It is bind-mounted at the same path inside the
# manager because worker containers are created through the host Docker socket.
CODING_ASSISTANT_DATA_DIR=/absolute/path/to/coding_assistant/.docker-data

# The manager user needs this supplemental group to access /var/run/docker.sock.
# Linux: stat -c '%g' /var/run/docker.sock
DOCKER_SOCKET_GID=999

# OpenAI-compatible LLM provider used by worker agents.
# For OpenRouter, use https://openrouter.ai/api/v1.
OPENAI_API_KEY=
OPENAI_BASE_URL=
