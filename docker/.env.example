# security notes.

CODING_ASSISTANT_DATA_DIR=/absolute/path/to/coding_assistant/.docker-data

CODING_ASSISTANT_DOCKER_SOCKET_GID=999

OPENAI_API_KEY=
OPENAI_BASE_URL=

CODING_ASSISTANT_MANAGER_AUTH_SECRET=
