# Deployer source of truth for Docker manager environment variables.
# Copy to docker/.env and fill in local values:
# cp docker/.env.example docker/.env
#
# Project-owned variables use the CODING_ASSISTANT_ prefix. Provider and tool
# variables keep their standard names, such as OPENAI_API_KEY and OPENAI_BASE_URL.

# Must be an absolute host path. It is bind-mounted at the same path inside the
# manager because worker containers are created through the host Docker socket.
CODING_ASSISTANT_DATA_DIR=/absolute/path/to/coding_assistant/.docker-data

# The manager user needs this supplemental group to access /var/run/docker.sock.
# Linux: stat -c '%g' /var/run/docker.sock
CODING_ASSISTANT_DOCKER_SOCKET_GID=999

# OpenAI-compatible LLM provider used by worker agents.
# For OpenRouter, use https://openrouter.ai/api/v1.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Shared secret used by trusted backend/local clients to call the manager API.
# Do not pass this value to worker containers.
#
# The manager container mounts /var/run/docker.sock and can control the host
# Docker daemon. Treat the manager as trusted infrastructure: the secret protects
# the manager API, but it does not sandbox the manager container itself.
CODING_ASSISTANT_MANAGER_AUTH_SECRET=
